package scry:plugin;

interface types {
    record entity-ref {
        path: string,      // z.B. "payload.artist"
        namespace: string, // z.B. "scry.music"
        typ: string,       // z.B. "artist"
        id: string,        // z.B. "The Beatles"
    }

    record relationship {
        source-namespace: string,
        source-type: string,
        source-id: string,
        predicate: string, // z.B. "scry.music/by_artist"
        target-namespace: string,
        target-type: string,
        target-id: string,
    }

    record event {
        id: string,
        timestamp: string,
        category: string,
        source: string,
        payload: string,
        metadata: option<string>,
        entities: list<entity-ref>,
        context: list<string>,
        context-info: option<string>,
        display-title: option<string>,
        display-subtitle: option<string>,
    }

    record data-field {
        category: string,
        path: string,
        semantic-type: string,
        description: string,
        format: option<string>,
        icon: option<string>,
    }

    record domain-info {
        ns: string,
        icon: option<string>,
    }

    record predicate-definition {
        id: string,
        label: string,
        inverse-label: string,
    }

    record trait-capability {
        entity-namespace: string,
        entity-type: string,
        trait-id: string,
    }

    enum widget-template {
        metric,
        trend,
        top-list,
        status,
        spotlight
    }

    record widget-definition {
        id: string,
        title: string,
        template: widget-template,
        config-json: string,
    }

    record manifest {
        id: string,
        name: string,
        version: string,
        description: string,
        subscriptions: list<string>,
        capabilities: list<string>,
        exports: list<data-field>,
        domain-info: list<domain-info>,
        predicates: list<predicate-definition>,
        provided-traits: list<trait-capability>,
        poll-interval: option<u32>,
        config-schema: option<string>,
        suggested-widgets: list<widget-definition>,
    }

    enum visualization { table, bar-chart, line-chart, pie-chart }

    record report-metadata {
        id: string,
        name: string,
        description: string,
        viz: visualization,
    }

    record report-data {
        columns: list<string>,
        data-json: string,
    }
}

interface host {
    use types.{event, relationship};

    variant query-param {
        s(string),
        i(s64),
        f(f64),
    }

    query: func(sql: string, params: list<query-param>) -> result<string, string>;
    http-get: func(url: string) -> result<string, string>;
    set-state: func(key: string, value: string);
    get-state: func(key: string) -> option<string>;
    get-config: func(key: string) -> option<string>;
    get-profile-value: func(key: string) -> option<string>;
    log: func(level: string, message: string);

    set-entity-trait: func(namespace: string, typ: string, id: string, trait-id: string, value-json: string);
    get-entity-trait: func(namespace: string, typ: string, id: string, trait-id: string) -> option<string>;

    set-relationship: func(rel: relationship);
    get-relationships: func(namespace: string, typ: string, id: string, direction: string) -> list<relationship>;
}

world plugin {
    import host;
    use types.{event, report-metadata, report-data, manifest, entity-ref};

    export get-manifest: func() -> manifest;
    export on-init: func() -> result<_, string>;
    export on-ingest: func(ev: event) -> result<event, string>;
    export on-poll: func() -> list<event>;
    export get-reports: func() -> list<report-metadata>;
    export run-report: func(report-id: string) -> result<report-data, string>;
    export get-summary: func(start-ts: string, end-ts: string) -> string;
    export resolve-trait: func(namespace: string, typ: string, id: string, trait-id: string) -> result<option<string>, string>;
    export on-entity-discovered: func(namespace: string, typ: string, id: string);
}
